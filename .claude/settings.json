      "Bash(sh *apply-ruleset.sh*)",
      "Bash(bash *apply-ruleset.sh*)",
      "Bash(./scripts/apply-ruleset.sh*)",
      "Bash(scripts/apply-ruleset.sh*)",
      "PowerShell(sh *apply-ruleset.sh*)",
