# Create .env for local development with `pnpm env:init` (copies this file and generates
# BETTER_AUTH_SECRET; an existing .env is kept as .env.backup). Never commit .env.
# Every variable is validated on first use by src/lib/env (names are reported, never values).

# development | test | production (set by Next.js; override only for scripts)
# NODE_ENV=development

# local | ci | staging | production
APP_ENV=local

# Public base URL of the app, used for links in emails and metadata
APP_URL=http://localhost:3000

# Local PostgreSQL from docker compose (port 5433; 127.0.0.1, not localhost, which may resolve to IPv6).
# Throwaway local credential, matching docker-compose.yml.
DATABASE_URL=postgresql://avelys:avelys_local@127.0.0.1:5433/avelys

# Better Auth (VTC-016): signs and encrypts session cookies and TOTP secrets. At least 32 characters.
# Generate your own local value, e.g. `openssl rand -base64 32`; never reuse it outside your machine.
BETTER_AUTH_SECRET=

# Reverse proxies trusted in X-Forwarded-For for auth rate limiting (comma-separated IPs or
# CIDR ranges). Leave empty locally; deployed values come from INFRA-005.
TRUSTED_PROXIES=

# Back-office session lifetime in seconds. Provisional; empty = default (7 days).
AUTH_SESSION_MAX_AGE_SECONDS=

# Google Maps Platform server key (VTC-024): Routes API only, restricted by API and IP; never the
# browser key. Optional: without it, route computation fails with a typed error (no price).
# Tests never call Google (mocked fetch). Obtaining a key is a human action (DEC-17, Maps budget).
GOOGLE_MAPS_SERVER_API_KEY=

# Google Maps Platform BROWSER key (VTC-046): Places API (New) autocomplete on the booking page,
# a key distinct from the server key, restricted to the site's HTTP referrers (e.g. localhost:3000
# locally) and to Places API (New), with quotas and budget alerts at the free tier (DEC-17).
# It reaches the browser by design, but is read by the server at request time only to hand it to
# the page (never used by the server to call Google). Optional: without it the booking page shows
# "online quote unavailable" and a contact link, never a price. Creating it is a human action.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_API_KEY=

# Stripe (VTC-030), TEST MODE ONLY: any value other than a test key (sk_test_/rk_test_,
# pk_test_) is refused at startup and by the adapter, live keys included. Take them from the
# Stripe Dashboard in test mode; never commit, paste or log them. Optional: without them,
# payments and the webhook endpoint fail with a typed error (WEBHOOK_NOT_CONFIGURED).
STRIPE_SECRET_KEY=
# Printed by `stripe listen` in local dev (docs/product/payments.md#webhooks-en-local).
STRIPE_WEBHOOK_SECRET=
# Payment Element of the public booking form (VTC-047). Read by the server at request time and
# handed to the page (never inlined at build). Empty: the form offers contact instead of a card.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Resend transactional email (VTC-043, docs/architecture/email.md). All optional: without the key
# or the sender, every email is traced FAILED (EMAIL_NOT_CONFIGURED) and bookings are unaffected.
# Use a Resend key of your own for local tests (never commit, paste or log it); separate keys per
# environment. EMAIL_FROM is "address" or "Name <address>"; PROVISIONAL, the sending domain
# depends on DEC-01b (SPF/DKIM). Tests never send a real email.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Minimum booking lead time in minutes (BR-31), > 0. Provisional; empty = default (720, i.e. 12 h).
BOOKING_MIN_LEAD_TIME_MINUTES=

# Broad service area of routed points (VTC-039), "south,west,north,east" in degrees. A resolved
# point outside it, or at (0, 0), gets no price. Provisional; empty = default (metropolitan
# France, 41,-5.5,51.5,10). A sanity guard, not the commercial operating zone.
ROUTING_SERVICE_AREA=

# Public booking routes (VTC-045): POST /api/v1/bookings and /api/v1/payment-setups answer 404
# unless "true"; the booking page offers the online quote only when "true" (VTC-046).
# Off by default in the app (empty or "false"); set to "true" here for local development only.
# Production enablement is INFRA-006 only, after per-IP rate limiting (INFRA-005).
PUBLIC_BOOKING_ENABLED=true

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
