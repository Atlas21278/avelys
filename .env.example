# Copy to .env for local development (cmd: copy .env.example .env). Never commit .env.
# Every variable is validated on first use by src/lib/env (names are reported, never values).

# development | test | production (set by Next.js; override only for scripts)
# NODE_ENV=development

# local | ci | staging | production
APP_ENV=local

# Public base URL of the app, used for links in emails and metadata
APP_URL=http://localhost:3000

# Local PostgreSQL from docker compose (port 5433; 127.0.0.1, not localhost, which may resolve to IPv6).
# Throwaway local credential, matching docker-compose.yml.
DATABASE_URL=postgresql://avelys:avelys_local@127.0.0.1:5433/avelys

# Better Auth (VTC-016): signs and encrypts session cookies and TOTP secrets. At least 32 characters.
# Generate your own local value, e.g. `openssl rand -base64 32`; never reuse it outside your machine.
BETTER_AUTH_SECRET=

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
