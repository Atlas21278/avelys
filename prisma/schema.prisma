// Avelys data model. Conventions and the SQL that Prisma cannot express
// (btree_gist, exclusion constraints) are documented in docs/architecture/database.md.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Authentication (VTC-016, ADR-0005). Tables required by Better Auth (core,
// two-factor plugin, database rate limiting); field names follow its schema.
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  DISPATCHER
  DRIVER
  CUSTOMER
}

model User {
  id               String      @id
  name             String
  email            String      @unique
  emailVerified    Boolean     @default(false)
  image            String?
  // Never accepted from a client request (Better Auth field with input: false).
  role             UserRole    @default(CUSTOMER)
  twoFactorEnabled Boolean     @default(false)
  createdAt        DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @db.Timestamptz(3)
  sessions         Session[]
  accounts         Account[]
  twoFactors       TwoFactor[]
  // Customer profile linked to this account, if any (VTC-026). The foreign key lives on Customer.
  customer         Customer?
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  // Password hash (credential provider); never the password itself.
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

model TwoFactor {
  id                      String    @id
  // Encrypted with BETTER_AUTH_SECRET, as are the backup codes.
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime? @db.Timestamptz(3)

  @@index([secret])
  @@index([userId])
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  // Epoch milliseconds, as written by Better Auth.
  lastRequest BigInt
}

// ---------------------------------------------------------------------------
// Booking (VTC-026, Master Spec §20.1, ADR-0007, ADR-0008, ADR-0009, ADR-0015).
// Deferred, additive later: driverId/vehicleId/blockedFrom/blockedUntil and the exclusion
// constraints (EPIC-11), the current Payment reference (EPIC-10). See database.md.
// ---------------------------------------------------------------------------

/// Mirrors BOOKING_STATUSES (src/domain/booking/status.ts); a unit test fails if they diverge.
/// No payment status (BR-41) and no ON_TRIP (computed, BR-22) here.
enum BookingStatus {
  REQUESTED
  ACCEPTED
  REFUSED
  CANCELLED
  CONFIRMED
  DRIVER_ASSIGNED
  IN_PROGRESS
  NO_SHOW
  COMPLETED
}

/// Mirrors BOOKING_ACTORS (src/domain/booking/transitions.ts); a unit test fails if they diverge.
enum ActorType {
  CUSTOMER
  ADMIN
  DISPATCHER
  DRIVER
  SYSTEM
}

/// Mirrors routing.locales (src/i18n/routing.ts); a unit test fails if they diverge.
enum Locale {
  fr
  en
}

/// Scheduled arrival of the customer at an airport or a station (BR-34).
enum TransportKind {
  FLIGHT
  TRAIN
}

/// Customer profile. Exists without a User (guest checkout); `userId` links an account later.
/// Email is deliberately not unique: deduplication belongs to the booking service.
model Customer {
  id              String    @id @default(cuid(2))
  name            String
  email           String
  phone           String?
  preferredLocale Locale    @default(fr)
  userId          String?   @unique
  user            User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  bookings        Booking[]

  @@index([email])
}

model Booking {
  id         String   @id @default(cuid(2))
  /// Canonical form from createReference (VTC-XXXXXXXX); prefix provisional (DEC-22).
  reference  String   @unique @db.VarChar(32)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  pickupLabel    String
  pickupLat      Float
  pickupLng      Float
  pickupPlaceId  String?
  dropoffLabel   String
  dropoffLat     Float
  dropoffLng     Float
  dropoffPlaceId String?

  /// Pickup instant, UTC (BR-52).
  pickupAt            DateTime @db.Timestamptz(3)
  /// Wall-clock date and time as entered, in pickupTimeZone (no offset; read with getUTC*).
  pickupLocalDateTime DateTime @db.Timestamp(0)
  /// IANA time zone of pickupLocalDateTime.
  pickupTimeZone      String   @default("Europe/Paris") @db.VarChar(64)

  passengerCount Int
  luggageCount   Int

  /// Road route of the quote (never as the crow flies, BR-51).
  quotedDistanceMeters  Int
  quotedDurationSeconds Int

  /// Integer cents (BR-10, BR-11). HT and VAT stay null until DEC-04 (VAT) is decided:
  /// no VAT rate lives in the code.
  totalTtcCents      Int
  totalHtCents       Int?
  vatCents           Int?
  /// ISO 4217.
  currency           String @db.Char(3)
  /// Immutable pricing snapshot validated by a versioned Zod schema (BR-13, ADR-0009).
  pricingSnapshot    Json
  /// Rule version the quote was priced with (VTC-025). Composite key: the pair must exist as is.
  pricingRuleId      String
  pricingRuleVersion Int
  pricingRule        PricingRule @relation(fields: [pricingRuleId, pricingRuleVersion], references: [id, version], onDelete: Restrict, onUpdate: Restrict)

  status BookingStatus @default(REQUESTED)

  /// Airport or station arrival (BR-34): scheduled time distinct from pickupAt.
  transportKind        TransportKind?
  transportNumber      String?
  transportOrigin      String?
  transportTerminal    String?
  transportScheduledAt DateTime?      @db.Timestamptz(3)

  customerNotes String?
  internalNotes String?

  /// Optimistic lock, incremented by every write of the booking service.
  version Int @default(1)

  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)

  @@index([status])
  @@index([pickupAt])
  @@index([customerId])
}

/// Append-only audit trail (BR-30): the application never updates or deletes a row.
/// before/after carry no personal data (BR-60). The entity is polymorphic, hence no foreign key.
model AuditLog {
  id            String    @id @default(cuid(2))
  actorType     ActorType
  /// User id for staff and drivers, Customer id for customers, null for SYSTEM.
  actorId       String?
  entityType    String    @db.VarChar(64)
  entityId      String
  action        String    @db.VarChar(64)
  before        Json?
  after         Json?
  correlationId String?   @db.VarChar(128)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId, createdAt])
}

// ---------------------------------------------------------------------------
// Pricing (VTC-025, Master Spec §8, ADR-0009). No tariff value lives in the code (BR-02):
// the only provisional values are in the dev seed (prisma/seed.ts, DEC-03).
// ---------------------------------------------------------------------------

/// Immutable pricing rule version (BR-13): the application only inserts rows, never updates or
/// deletes them. A new tariff is a new version; bookings keep their own snapshot.
model PricingRule {
  id            String    @id @default(cuid(2))
  /// Monotonic across all rules, allocated as max + 1 by the service (unique constraint + retry).
  version       Int       @unique
  /// The rule applies from this instant (UTC) until a higher version takes over.
  effectiveFrom DateTime  @db.Timestamptz(3)
  /// Tariff fields of PricingRuleConfig without id/version/schemaVersion (taken from the
  /// columns), validated by parsePricingRule on write and on read.
  config        Json
  /// PRICING_RULE_SCHEMA_VERSION of `config` (src/domain/pricing/rule.ts).
  schemaVersion Int
  /// Staff User id of the author; null for the dev seed. No foreign key, like AuditLog.actorId.
  createdBy     String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  bookings      Booking[]

  /// Target of the composite foreign key from Booking (id + version must match).
  @@unique([id, version])
  @@index([effectiveFrom])
}
